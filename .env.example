# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Present because Supabase issues it, but this app never uses it: RLS is
# deny-all and there is no browser-side Supabase client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-only — never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio. Server-only, same rule.
GEMINI_API_KEY=
